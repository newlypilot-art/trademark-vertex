# Copy this file to .env.local. It is git-ignored and never reaches your host.
#
# IMPORTANT: do NOT set ENABLE_DASHBOARD in Vercel (or any host). Leaving it
# unset is what makes /dashboard return a real 404 on the live site.

# Turns the local authoring dashboard on. Unset = on in `npm run dev`, OFF in
# any production build. Set it to true here so `npm run build && npm start`
# also gives you the dashboard locally.
ENABLE_DASHBOARD=true

# Password for the /dashboard login screen.
DASHBOARD_PASSWORD=change-me-now

# A long random string used to sign the dashboard session cookie.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SECRET=replace-with-a-long-random-string

# The public URL of THIS deployment, used for canonical tags, sitemap.xml and
# Open Graph. Set this per domain in each Vercel project's env vars.
NEXT_PUBLIC_SITE_URL=https://trademarkvertex.com

# ---------------------------------------------------------------------------
# Optional, production only
# ---------------------------------------------------------------------------
# On Vercel the filesystem is read-only, so contact form submissions cannot be
# written to data/leads.json. They are always printed to the function logs, and
# if you set a webhook URL here every submission is POSTed to it as JSON.
# Works with Zapier, Make, a Google Apps Script, Slack or Discord.
# LEAD_WEBHOOK_URL=
